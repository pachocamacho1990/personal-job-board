# Database credentials
DB_PASSWORD=change_this_to_a_strong_password

# JWT Secret (generate with: openssl rand -base64 64)
JWT_SECRET=change_this_to_a_very_long_random_string

# Cassimir Management Center — only needed for "transform job into opportunity".
# Leave blank and that action returns 503; nothing else is affected.
#
# Mint the token inside the CMC repository, not here:
#   node scripts/create-integration-token.js you@example.com jobboard
#
# It is deliberately NOT this app's JWT_SECRET. Sharing that would let a session
# token from one app authenticate against the other.
CMC_API_URL=http://host.docker.internal:8080
CMC_INTEGRATION_TOKEN=
